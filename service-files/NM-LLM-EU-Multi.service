[Unit]
Description=Network Monitor LLM EU multi-profile host

[Service]
WorkingDirectory=/home/mahadeva/code/services/llm-eu-multi
ExecStart=/usr/bin/dotnet /home/mahadeva/code/services/llm-eu-multi/NetworkMonitorLLM.dll
SyslogIdentifier=NM-LLM-EU-Multi
User=nmuser
Group=nmgroup
Restart=always
RestartSec=5
KillSignal=SIGINT
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false

[Install]
WantedBy=multi-user.target
