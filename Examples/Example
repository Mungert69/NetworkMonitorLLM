namespace NetworkMonitor.Connection
{
    public class FTPConnectionTesterCmdProcessor : CmdProcessor
    {
        // Parser schema
        private static readonly List<ArgSpec> _schema = new()
        {
            new ArgSpec
            {
                Key = "username",
                Required = true,
                IsFlag = false,
                TypeHint = "value",
                Help = "FTP username."
            },
            new ArgSpec
            {
                Key = "password",
                Required = true,
                IsFlag = false,
                TypeHint = "value",
                Help = "FTP password."
            },
            new ArgSpec
            {
                Key = "host",
                Required = true,
                IsFlag = "value" == "bool" ? true : false, // noop, just to show we thought about it
                TypeHint = "value",
                Help = "FTP host (e.g., 'ftp.example.com' or '192.168.1.10')."
            },
            new ArgSpec
            {
                Key = "path",
                Required = false,
                IsFlag = false,
                TypeHint = "value",
                DefaultValue = "",
                Help = "Remote path to test (default: root)."
            },
            new ArgSpec
            {
                Key = "ssl",
                Required = false,
                IsFlag = true,
                DefaultValue = "false",
                Help = "Use FTPS (EnableSsl)."
            },
            new ArgSpec
            {
                Key = "passive",
                Required = false,
                IsFlag = true,
                DefaultValue = "true",
                Help = "Use passive mode."
            },
            new ArgSpec
            {
                Key = "port",
                Required = false,
                IsFlag = false,
                TypeHint = "int",
                DefaultValue = "21",
                Help = "FTP port (21 for FTP, 990 often used for implicit FTPS)."
            },
            new ArgSpec
            {
                Key = "timeout_ms",
                Required = false,
                IsFlag = false,
                TypeHint = "int",
                DefaultValue = "30000",
                Help = "Request timeout in milliseconds."
            },
        };

        public FTPConnectionTesterCmdProcessor(
            ILogger logger,
            ILocalCmdProcessorStates cmdProcessorStates,
            IRabbitRepo rabbitRepo,
            NetConnectConfig netConfig)
            : base(logger, cmdProcessorStates, rabbitRepo, netConfig) { }

        public override async Task<ResultObj> RunCommand(
            string arguments,
            CancellationToken cancellationToken,
            ProcessorScanDataObj? processorScanDataObj = null)
        {
            var result = new ResultObj();

            try
            {
                cancellationToken.ThrowIfCancellationRequested();

                // Parse & validate args via schema
                var parse = CliArgParser.Parse(arguments, _schema, allowUnknown: false, fillDefaults: true);
                if (!parse.Success)
                {
                    result.Success = false;
                    result.Message = CliArgParser.BuildErrorMessage(_cmdProcessorStates.CmdDisplayName, parse, _schema);
                    return result;
                }

                var username   = parse.GetString("username");
                var password   = parse.GetString("password");
                var host       = parse.GetString("host");
                var path       = parse.GetString("path", "");
                var useSsl     = parse.GetBool("ssl", false);
                var passive    = parse.GetBool("passive", true);
                var port       = parse.GetInt("port", 21);
                var timeoutMs  = parse.GetInt("timeout_ms", 30000);

                // Build URI: ftp://host[:port][/path]
                var baseUri = new UriBuilder
                {
                    Scheme = "ftp",
                    Host   = host,
                    Port   = port <= 0 ? -1 : port, // -1 means default port for the scheme
                    Path   = (path ?? "").TrimStart('/')
                }.Uri;

                _logger.LogInformation("Testing FTP connection to {host} (ssl={ssl}, passive={passive}, port={port}, path='{path}') with username: {user}",
                    host, useSsl, passive, port, path, username);

#pragma warning disable SYSLIB0014 // FtpWebRequest is obsolete in newer frameworks but still functional
                var request = (FtpWebRequest)WebRequest.Create(baseUri);
#pragma warning restore SYSLIB0014

                request.Credentials = new NetworkCredential(username, password);
                request.Method = WebRequestMethods.Ftp.ListDirectory;
                request.EnableSsl = useSsl;
                request.UsePassive = passive;
                request.ReadWriteTimeout = timeoutMs;
                request.Timeout = timeoutMs;

                using (cancellationToken.Register(() => request.Abort()))
                {
                    try
                    {
                        cancellationToken.ThrowIfCancellationRequested();

                        using var response = (FtpWebResponse)await request.GetResponseAsync();
                        result.Success = true;
                        result.Message = $"FTP connection successful. Status: {response.StatusDescription}";
                    }
                    catch (WebException ex) when (ex.Status == WebExceptionStatus.RequestCanceled)
                    {
                        _logger.LogInformation("FTP request was canceled.");
                        result.Success = false;
                        result.Message = "Operation canceled by user.";
                    }
                    catch (WebException ex)
                    {
                        if (ex.Response is FtpWebResponse ftpResponse)
                        {
                            _logger.LogError("FTP error: {status}", ftpResponse.StatusDescription);
                            result.Success = false;
                            result.Message = $"FTP connection failed. Status: {ftpResponse.StatusDescription}";
                        }
                        else
                        {
                            _logger.LogError("FTP error: {msg}", ex.Message);
                            result.Success = false;
                            result.Message = $"FTP connection failed. Error: {ex.Message}";
                        }
                        LogErrorToFile(result.Message);
                    }
                }
            }
            catch (OperationCanceledException)
            {
                _logger.LogInformation("FTP connection operation was canceled by the user.");
                result.Success = false;
                result.Message = "Operation canceled by user.";
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error testing FTP connection");
                result.Success = false;
                result.Message = $"Error testing FTP connection: {ex.Message}";
                LogErrorToFile(result.Message);
            }

            return result;
        }

      public override string GetCommandHelp()
{
    var header = "Tests an FTP/FTPS connection by attempting to list a remote directory.\n";
    var usage  = CliArgParser.BuildUsage(_cmdProcessorStates.CmdDisplayName, _schema);

    var examples = @"
Examples:
  --username admin --password admin123 --host ftp.example.com
  --username u --password p --host 10.0.0.5 --ssl --port 990 --path /incoming
";

    return $"{header}\n{usage}\n{examples}";
}

        private void LogErrorToFile(string errorMessage)
        {
            try
            {
                if (string.IsNullOrEmpty(_rootFolder))
                {
                    _logger.LogError("Error: _rootFolder is not set.");
                    return;
                }

                var logDirectory = Path.Combine(_rootFolder, "logs");
                Directory.CreateDirectory(logDirectory);

                var logFilePath = Path.Combine(logDirectory, $"{GetType().Name}.log");
                var logMessage = $"{DateTime.UtcNow:yyyy-MM-dd HH:mm:ss} - {errorMessage}{Environment.NewLine}";

                File.AppendAllText(logFilePath, logMessage);
            }
            catch (Exception ex)
            {
                _logger.LogError("Failed to write to error log file: {msg}", ex.Message);
            }
        }
    }
}
