#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "Usage: $0 [--dotnet-path /path/to/dotnet]"
}

DOTNET_PATH_OVERRIDE="${DOTNET_PATH:-}"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dotnet-path)
      shift
      [[ $# -gt 0 ]] || { echo "ERROR: --dotnet-path requires a value."; usage; exit 1; }
      DOTNET_PATH_OVERRIDE="$1"
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "ERROR: Unknown argument: $1"
      usage
      exit 1
      ;;
  esac
  shift
done

[[ $EUID -eq 0 ]] || { echo "ERROR: Run this script with sudo."; exit 1; }

ROOTDIR="/home/mahadeva"
TARGET_DIR="$ROOTDIR/code/services/llm-eu-multi"
ENV_SOURCE="$ROOTDIR/code/securefiles/domain-env"
SERVICE="NM-LLM-EU-Multi.service"
SERVICE_SOURCE="$(dirname "$0")/../service-files/$SERVICE"
CONFIG_SOURCE="$(dirname "$0")/../appsettings-multi-eu.json"
OLD_SERVICES=(
  NM-LLM-EU-Nmap.service NM-LLM-EU-Meta.service NM-LLM-EU-Metalive.service
  NM-LLM-EU-Search.service NM-LLM-EU-CmdProcessor.service NM-LLM-EU-ReportData.service
  NM-LLM-EU-BlogMonitor.service NM-LLM-EU-Quantum.service NM-LLM-EU-Timesfm.service
  NM-LLM-EU-Connect.service NM-LLM-EU-AgentFlow.service NM-LLM-EU-MonitorSys.service
  NM-LLM-EU-Monitor.service NM-LLM-EU-json_dynamic.service NM-LLM-EU-Camera.service
  NM-LLM-EU-Memory.service
)

if [[ -n "$DOTNET_PATH_OVERRIDE" ]]; then
  [[ -x "$DOTNET_PATH_OVERRIDE" ]] || { echo "ERROR: dotnet path is not executable: $DOTNET_PATH_OVERRIDE"; exit 1; }
  DOTNET_CMD="$DOTNET_PATH_OVERRIDE"
else
  DOTNET_CMD="$(command -v dotnet || true)"
  [[ -n "$DOTNET_CMD" ]] || { echo "ERROR: dotnet was not found in PATH."; exit 1; }
fi

case "$(uname -m)" in
  aarch64|arm64) DOTNET_ARCH=arm64 ;;
  x86_64|amd64) DOTNET_ARCH=x64 ;;
  *) echo "ERROR: Unsupported architecture: $(uname -m)"; exit 1 ;;
esac

[[ -f "$SERVICE_SOURCE" ]] || { echo "ERROR: Missing service unit: $SERVICE_SOURCE"; exit 1; }
[[ -f "$CONFIG_SOURCE" ]] || { echo "ERROR: Missing multi-profile configuration: $CONFIG_SOURCE"; exit 1; }

if ! getent group 1654 >/dev/null; then groupadd --gid 1654 nmgroup; fi
if ! id -u 1654 >/dev/null 2>&1; then useradd --uid 1654 --gid 1654 --shell /usr/sbin/nologin --no-create-home nmuser; fi

escape_sed_replacement() { printf '%s' "$1" | sed -e 's/[\\/&]/\\\\&/g'; }
SERVICE_TMP_FILE="$(mktemp)"
sed "s|/usr/bin/dotnet|$(escape_sed_replacement "$DOTNET_CMD")|g" "$SERVICE_SOURCE" > "$SERVICE_TMP_FILE"
install -m 644 "$SERVICE_TMP_FILE" "/etc/systemd/system/$SERVICE"
rm -f "$SERVICE_TMP_FILE"
systemctl daemon-reload
systemctl enable "$SERVICE"

mkdir -p "$TARGET_DIR"
systemctl stop "$SERVICE" || true
find "$TARGET_DIR" -mindepth 1 -delete

echo "Publishing the EU multi-profile host to $TARGET_DIR ..."
"$DOTNET_CMD" publish "$(dirname "$0")/../NetworkMonitorLLM.csproj" \
  --os linux --arch "$DOTNET_ARCH" --output "$TARGET_DIR" -c Release \
  --self-contained false /p:UseAppHost=false /nodeReuse:false

# The application always loads appsettings.json at startup.  The profile files
# are already included in the publish output by the project file.
install -m 640 "$CONFIG_SOURCE" "$TARGET_DIR/appsettings.json"
chown -R nmuser:nmgroup "$TARGET_DIR"
find "$TARGET_DIR" -type d -exec chmod 750 {} \;
find "$TARGET_DIR" -type f -exec chmod 640 {} \;
chgrp nmgroup "$ENV_SOURCE"
chmod 640 "$ENV_SOURCE"
rm -f "$TARGET_DIR/.env"
ln -s "$ENV_SOURCE" "$TARGET_DIR/.env"

# Prevent the old units and the multi-profile host consuming the same queues.
for old_service in "${OLD_SERVICES[@]}"; do
  systemctl disable --now "$old_service" || true
done

systemctl start "$SERVICE"
echo "Published and started $SERVICE. Old EU per-profile services are disabled."
