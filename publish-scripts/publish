#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "Usage: $0 [--dotnet-path /path/to/dotnet]"
}

DOTNET_PATH_OVERRIDE=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dotnet-path)
      shift
      if [[ $# -eq 0 ]]; then
        echo "ERROR: --dotnet-path requires a value."
        usage
        exit 1
      fi
      DOTNET_PATH_OVERRIDE="$1"
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "ERROR: Unknown argument: $1"
      usage
      exit 1
      ;;
  esac
  shift
done

PUBLISH_INSTANCE_ARGS=()
if [[ -n "$DOTNET_PATH_OVERRIDE" ]]; then
  PUBLISH_INSTANCE_ARGS=(--dotnet-path "$DOTNET_PATH_OVERRIDE")
fi

# US instances
