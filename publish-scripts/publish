# ./publish-instance us Meta "${PUBLISH_INSTANCE_ARGS[@]}"
# ./publish-instance us Search "${PUBLISH_INSTANCE_ARGS[@]}"
# ./publish-instance us Monitor "${PUBLISH_INSTANCE_ARGS[@]}"

# EU instances
