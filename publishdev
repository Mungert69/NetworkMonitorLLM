#!/usr/bin/env bash
set -euo pipefail

usage() {
    echo "Usage: $0 [--dotnet-path /path/to/dotnet]"
}

DOTNET_PATH_OVERRIDE=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --dotnet-path)
            shift
            if [[ $# -eq 0 ]]; then
                echo "ERROR: --dotnet-path requires a value."
                usage
                exit 1
            fi
            DOTNET_PATH_OVERRIDE="$1"
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "ERROR: Unknown argument: $1"
            usage
            exit 1
            ;;
    esac
    shift
done

# Ensure group exists (ignore if it already does)
if ! getent group 1654 >/dev/null; then
    echo "Creating group nmgroup (gid=1654)"
    sudo groupadd --gid 1654 nmgroup
else
    echo "Group nmgroup already exists"
fi

# Ensure user exists (ignore if it already does)
if ! id -u 1654 >/dev/null 2>&1; then
    echo "Creating user nmuser (uid=1654)"
    sudo useradd --uid 1654 --gid 1654 --shell /usr/sbin/nologin --no-create-home nmuser
else
    echo "User nmuser already exists"
fi

# --- Ensure world-traverse on parent dirs ---
echo "Ensuring world traverse on parent directories ..."
sudo chmod o+x /home/mahadeva
sudo chmod o+x /home/mahadeva/code
sudo chown -R mahadeva:nmgroup /home/mahadeva/code/services

#dotnet test 
#dotnet test ../NetworkMonitorLib/NetworkMonitor.csproj
#dotnet test ../NetworkMonitorData/NetworkMonitorData.csproj

cd publish-scripts
if [[ -n "$DOTNET_PATH_OVERRIDE" ]]; then
    sudo ./publish-dev --dotnet-path "$DOTNET_PATH_OVERRIDE"
else
    sudo ./publish-dev
fi
